# Application runtime
META_ENVIRONMENT=development
META_LOG_LEVEL=INFO
META_APP_NAME=Meta REST API
META_APP_VERSION=0.1.0

# Meta platform integration (required in production)
META_META_APP_ID=your-meta-app-id
META_META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v21.0
META_REQUEST_TIMEOUT=10

# Persistence and application security (required in production)
META_DATABASE_URL=sqlite+aiosqlite:///./meta_api.db
META_ENCRYPTION_KEY=replace-with-a-secret-encryption-key
META_SIGNING_KEY=replace-with-a-secret-signing-key
# Optional: protect event retrieval endpoints; ingestion remains independent
META_EVENT_READ_TOKEN=
